.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #4A90E2 0%, #67B26F 100%);
  padding: 40rpx;
}

.header {
  text-align: center;
  margin-bottom: 80rpx;
  padding-top: 60rpx;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 20rpx;
  text-shadow: 2rpx 2rpx 4rpx rgba(0,0,0,0.2);
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
}

.level-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.level-item {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.15);
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: transform 0.2s;
  position: relative;
  overflow: hidden;
}

.level-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.3), transparent);
  pointer-events: none;
}

.level-item:active {
  transform: scale(0.98);
}

.level-name {
  font-size: 40rpx;
  font-weight: bold;
  color: white;
  text-shadow: 1rpx 1rpx 2rpx rgba(0,0,0,0.3);
  z-index: 1;
}

.level-info {
  font-size: 24rpx;
  color: rgba(255,255,255,0.95);
  z-index: 1;
}

.level-arrow {
  font-size: 48rpx;
  color: white;
  font-weight: bold;
  z-index: 1;
}

.footer {
  margin-top: 80rpx;
  text-align: center;
}

.tip {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  line-height: 1.6;
}
