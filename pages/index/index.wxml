<view class="container">
  <view class="header">
    <text class="title">🚔 英语单词追捕</text>
    <text class="subtitle">选择你的等级，开始追捕小偷！</text>
  </view>

  <view class="level-list">
    <view
      class="level-item"
      wx:for="{{levels}}"
      wx:key="id"
      style="background: linear-gradient(135deg, {{item.color}}dd, {{item.color}})"
      bindtap="selectLevel"
      data-level="{{item.id}}"
    >
      <view class="level-name">{{item.name}}</view>
      <view class="level-info">{{item.wordCount}} 个单词</view>
      <view class="level-arrow">→</view>
    </view>
  </view>

  <view class="footer">
    <!-- 每日挑战横幅 -->
    <view class="challenge-banner" bindtap="goToChallenge">
      <view class="banner-left">
        <text class="banner-icon">🎯</text>
        <view class="banner-text">
          <text class="banner-title">每日挑战</text>
          <text class="banner-subtitle">完成挑战赢取积分</text>
        </view>
      </view>
      <text class="banner-arrow">→</text>
    </view>

    <view class="footer-buttons">
      <button class="footer-btn" bindtap="goToWrongBook">
        <text class="btn-icon">📖</text>
        <text>错题本</text>
      </button>
      <button class="footer-btn" bindtap="goToLeaderboard">
        <text class="btn-icon">🏆</text>
        <text>排行榜</text>
      </button>
    </view>
    <text class="tip">💡 输入正确单词，警察就能追上小偷！</text>
  </view>
</view>
