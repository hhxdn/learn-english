.container {
  min-height: 100vh;
  background: #f5f7fa;
}

/* 标签页 */
.tabs {
  display: flex;
  background: white;
  padding: 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  position: sticky;
  top: 0;
  z-index: 100;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 10rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-weight: bold;
}

/* 我的排名 */
.my-rank {
  background: linear-gradient(135deg, #ffd89b 0%, #19547b 100%);
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.15);
}

.rank-icon {
  font-size: 48rpx;
}

.rank-text {
  font-size: 32rpx;
  font-weight: bold;
  color: white;
}

/* 排行榜列表 */
.leaderboard-list {
  padding: 20rpx;
}

.empty {
  text-align: center;
  padding: 100rpx 20rpx;
}

.empty-icon {
  display: block;
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #999;
}

.rank-item {
  background: white;
  border-radius: 15rpx;
  padding: 25rpx;
  margin-bottom: 15rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  transition: all 0.3s;
}

.rank-item.highlight {
  background: linear-gradient(135deg, #e3f2fd 0%, #f3e5f5 100%);
  border: 2rpx solid #667eea;
}

.rank-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.rank-number {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #666;
}

.rank-number.top1 {
  background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(255, 215, 0, 0.4);
}

.rank-number.top2 {
  background: linear-gradient(135deg, #c0c0c0 0%, #e8e8e8 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(192, 192, 192, 0.4);
}

.rank-number.top3 {
  background: linear-gradient(135deg, #cd7f32 0%, #e6a85c 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(205, 127, 50, 0.4);
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.nickname {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.stats {
  font-size: 24rpx;
  color: #999;
}

.rank-right {
  text-align: right;
}

.accuracy {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 5rpx;
}

.label {
  display: block;
  font-size: 22rpx;
  color: #999;
}
