<view class="game-container">
  <!-- 游戏进度区域 -->
  <view class="progress-area">
    <view class="progress-bar">
      <!-- 警察图标 -->
      <view class="police-icon" style="left: {{policePosition}}%">
        <view class="police-car">
          <view class="car-body"></view>
          <view class="car-light"></view>
          <view class="car-window"></view>
        </view>
      </view>
      <!-- 小偷图标 -->
      <view class="thief-icon">
        <view class="thief-character">
          <view class="thief-head"></view>
          <view class="thief-body"></view>
          <view class="thief-bag"></view>
        </view>
      </view>
      <view class="progress-fill" style="width: {{policePosition}}%"></view>
    </view>
    <view class="progress-text">距离: {{distance}}%</view>
  </view>

  <!-- 单词显示区域 -->
  <view class="word-area">
    <view class="word-card">
      <text class="chinese">{{currentWord.chinese}}</text>
      <view class="phonetic-row">
        <text class="phonetic">{{currentWord.phonetic}}</text>
        <button class="speak-btn" bindtap="speakWord" wx:if="{{currentWord.word}}">
          <text class="speak-icon">🔊</text>
        </button>
      </view>
      <view class="word-count">第 {{currentIndex + 1}} / {{totalWords}} 个</view>
    </view>
  </view>

  <!-- 输入区域 -->
  <view class="input-area">
    <input
      class="word-input"
      type="text"
      placeholder="输入英文单词"
      value="{{userInput}}"
      bindinput="onInput"
      bindconfirm="submitAnswer"
      focus="{{inputFocus}}"
    />
    <button class="submit-btn" bindtap="submitAnswer">提交</button>
  </view>

  <!-- 提示信息 -->
  <view class="hint-area" wx:if="{{hintMessage}}">
    <text class="hint {{hintType}}">{{hintMessage}}</text>
  </view>

  <!-- 游戏信息 -->
  <view class="game-info">
    <view class="info-item">
      <text class="info-label">正确</text>
      <text class="info-value correct">{{correctCount}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">错误</text>
      <text class="info-value wrong">{{wrongCount}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">时间</text>
      <text class="info-value">{{timeText}}</text>
    </view>
  </view>
</view>
