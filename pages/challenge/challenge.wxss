.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f093fb 0%, #f5576c 100%);
  padding: 30rpx;
}

/* 挑战卡片 */
.challenge-card {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 12rpx 30rpx rgba(0,0,0,0.2);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.date {
  font-size: 24rpx;
  color: #999;
}

.challenge-info {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 25rpx;
  margin-bottom: 30rpx;
}

.info-item {
  background: #f8f9fa;
  padding: 20rpx;
  border-radius: 12rpx;
  text-align: center;
}

.label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.value {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.value.reward {
  color: #f5576c;
}

/* 用户状态 */
.user-status {
  background: #e3f2fd;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
}

.status-badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
}

.status-badge.completed {
  background: #d4edda;
  color: #155724;
}

.status-badge.in-progress {
  background: #fff3cd;
  color: #856404;
}

.status-detail {
  display: flex;
  justify-content: space-around;
  font-size: 24rpx;
  color: #666;
}

/* 开始按钮 */
.start-btn {
  width: 100%;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 30rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(245, 87, 108, 0.4);
}

.start-btn.disabled {
  background: #ccc;
  box-shadow: none;
}

.empty {
  text-align: center;
  padding: 60rpx 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 挑战规则 */
.challenge-rules {
  background: rgba(255,255,255,0.9);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.rules-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.rules-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.rule-item {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 排行榜按钮 */
.leaderboard-btn {
  width: 100%;
  background: rgba(255,255,255,0.9);
  color: #f5576c;
  border: none;
  border-radius: 50rpx;
  padding: 25rpx;
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.btn-icon {
  font-size: 32rpx;
}

/* 模态框 */
.modal {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
}

.modal.show {
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  background: white;
  border-radius: 20rpx;
  width: 90%;
  max-height: 80vh;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  padding: 20rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.rank-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.rank-number {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  color: #666;
  flex-shrink: 0;
}

.rank-number.top1 {
  background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
  color: white;
}

.rank-number.top2 {
  background: linear-gradient(135deg, #c0c0c0 0%, #e8e8e8 100%);
  color: white;
}

.rank-number.top3 {
  background: linear-gradient(135deg, #cd7f32 0%, #e6a85c 100%);
  color: white;
}

.nickname {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.score {
  font-size: 24rpx;
  color: #999;
}
