.result-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f093fb 0%, #f5576c 100%);
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.result-icon {
  display: block;
  font-size: 120rpx;
  margin-bottom: 30rpx;
  animation: bounce 1s ease infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

.result-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  text-shadow: 2rpx 2rpx 4rpx rgba(0,0,0,0.2);
}

.stats-card {
  background: white;
  border-radius: 30rpx;
  padding: 50rpx 40rpx;
  width: 100%;
  box-shadow: 0 12rpx 30rpx rgba(0,0,0,0.2);
  margin-bottom: 50rpx;
}

.stat-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.stat-item:last-child {
  border-bottom: none;
}

.stat-label {
  font-size: 32rpx;
  color: #666;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.stat-value.correct {
  color: #10b981;
}

.stat-value.wrong {
  color: #ef4444;
}

.rating-area {
  text-align: center;
  margin-bottom: 60rpx;
}

.rating-text {
  display: block;
  font-size: 32rpx;
  color: white;
  margin-bottom: 20rpx;
}

.stars {
  display: flex;
  justify-content: center;
  gap: 10rpx;
}

.star {
  font-size: 60rpx;
}

.button-group {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  width: 100%;
  border-radius: 20rpx;
  padding: 30rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.15);
}

.action-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.action-btn.secondary {
  background: white;
  color: #667eea;
}

.action-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}
